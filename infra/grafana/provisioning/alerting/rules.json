{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "caching",
      "folder": "Caching alerts",
      "interval": "30s",
      "rules": [
        {
          "uid": "tcc-hitrate-low",
          "title": "Cache hit rate below 80%",
          "condition": "B",
          "for": "1m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "{{ $labels.source }} cache is under 80% hit rate while actually serving traffic - too small, too short-lived, or keyed wrong."
          },
          "noDataState": "OK",
          "execErrState": "Error",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "instant": true,
                "range": false,
                "editorMode": "code",
                "expr": "(sum by (source) (rate(cache_hit_total[5m])) / (sum by (source) (rate(cache_hit_total[5m])) + sum by (source) (rate(cache_miss_total[5m])))) and ((sum by (source) (rate(cache_hit_total[5m])) + sum by (source) (rate(cache_miss_total[5m]))) > 0.1)"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        0.8
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "tcc-api-down",
          "title": "Metrics endpoint unreachable",
          "condition": "B",
          "for": "30s",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "Prometheus cannot scrape /api/metrics. Octane is down or reloading."
          },
          "noDataState": "OK",
          "execErrState": "Error",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "instant": true,
                "range": false,
                "editorMode": "code",
                "expr": "up{job=\"twitter-clone-caching\"}"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "tcc-cold-fallback",
          "title": "Feeds falling back to the database",
          "condition": "B",
          "for": "1m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Timelines are being served by the follows join, so inboxes are missing. Run feeds:backfill --missing."
          },
          "noDataState": "OK",
          "execErrState": "Error",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "instant": true,
                "range": false,
                "editorMode": "code",
                "expr": "sum(rate(cache_miss_total{source=\"cold\"}[5m]) + rate(cache_hit_total{source=\"cold\"}[5m]))"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.5
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "tcc-fanout-cost",
          "title": "Fanout writing a lot per post",
          "condition": "B",
          "for": "1m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "One post is costing over 500 inbox writes. This author belongs on the celebrity read-time path."
          },
          "noDataState": "OK",
          "execErrState": "Error",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "instant": true,
                "range": false,
                "editorMode": "code",
                "expr": "rate(fanout_deliveries_total[5m]) / clamp_min(rate(posts_total{fanout=\"delivered\"}[5m]), 0.0000001)"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        500
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "tcc-dup-db",
          "title": "Like dedupe missing in Redis",
          "condition": "B",
          "for": "1m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Duplicate likes are reaching Postgres - the Redis fast-path set is cold or was evicted."
          },
          "noDataState": "OK",
          "execErrState": "Error",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "instant": true,
                "range": false,
                "editorMode": "code",
                "expr": "sum(rate(likes_total{result=\"duplicate_db\"}[5m]))"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        1
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}